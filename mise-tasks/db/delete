#!/usr/bin/env bash
#MISE description="Delete current branch's Neon database"
set -euo pipefail
# shellcheck source=mise-tasks/db/_neon.sh
source "${BASH_SOURCE[0]%/*}/_neon.sh"
require_neon_project

CURRENT_BRANCH=$(git branch --show-current)

if [ "$CURRENT_BRANCH" = "main" ]; then
	echo "❌ Cannot delete main branch database"
	exit 1
fi

NEON_BRANCH=$(neon_branch_name "$CURRENT_BRANCH")

if neon branches delete "$NEON_BRANCH" --project-id "$NEON_PROJECT_ID"; then
	echo "✓ Deleted Neon branch: $NEON_BRANCH"
else
	echo "❌ Failed to delete branch (may not exist)"
	exit 1
fi
