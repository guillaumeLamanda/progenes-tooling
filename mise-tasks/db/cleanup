#!/usr/bin/env bash
#MISE description="Select and delete Neon branches (--list to inspect, --dry-run to preview)"
#MISE alias="db:delete-archived"
#MISE interactive=true
#MISE raw_args=true
set -euo pipefail

MODE=delete
case "${1:-}" in
	--list) MODE=list ;;
	--dry-run) MODE=dry-run ;;
	--help|-h)
		printf 'Usage: mise run db:cleanup [--list|--dry-run]\n\nTab selects branches; Ctrl-A selects all visible rows; Enter reviews the selection.\nDefault and protected branches are never listed.\n'
		exit 0
		;;
	'') ;;
	*) printf 'Unknown argument: %s\n' "$1" >&2; exit 1 ;;
esac
if [ "$#" -gt 1 ]; then
	printf 'Expected at most one argument.\n' >&2
	exit 1
fi

for tool in neon jq; do
	command -v "$tool" >/dev/null || { printf 'Missing dependency: %s\n' "$tool" >&2; exit 1; }
done
if [ "$MODE" != list ]; then
	command -v fzf >/dev/null || { printf 'Missing dependency: fzf\n' >&2; exit 1; }
fi
PROJECT_ID="${NEON_PROJECT_ID:?NEON_PROJECT_ID is not set}"

TMP=$(mktemp -d "${TMPDIR:-/tmp}/db-cleanup.XXXXXXXX")
trap 'rm -f "$TMP"/*; rmdir "$TMP"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

printf 'Fetching Neon branches...\n'
if ! neon branches list --project-id "$PROJECT_ID" --output json >"$TMP/branches" 2>"$TMP/neon-error"; then
	printf 'Failed to list Neon branches:\n' >&2
	cat "$TMP/neon-error" >&2
	exit 1
fi

# Archived first, then least recently updated. Default and protected branches are never offered.
jq -c '
	map(select((.default // .primary // false) == false and (.protected // false) == false and .name != "main"))
	| sort_by([(if .current_state == "archived" then 0 else 1 end), .updated_at])
	| .[] | {id, name, state: (.current_state // "unknown"), updated: ((.updated_at // "") | .[0:10])}
' "$TMP/branches" >"$TMP/inventory"
if [ ! -s "$TMP/inventory" ]; then printf 'No deletable branches found.\n'; exit 0; fi

# Only the branch ID is parsed back from fzf. Display text is never used as a delete target.
jq -r '
	def pad($n): . + (" " * ([$n - length, 0] | max));
	def display: gsub("[\u0000-\u001f\u007f]"; "?");
	"\(.id)\t" + ([.name | display | pad(48)] + [.state | pad(10)] + [.updated] | join("  "))
' "$TMP/inventory" >"$TMP/rows"
HEADER='BRANCH                                            STATE       UPDATED'
if [ "$MODE" = list ]; then
	printf '%s\n' "$HEADER"
	cut -f2- "$TMP/rows"
	exit 0
fi

if fzf --multi --delimiter=$'\t' --with-nth=2.. --bind 'ctrl-a:select-all' --header="$HEADER
Tab: select | Ctrl-A: select all visible | Enter: review | Esc: cancel
Type \"archived\" then Ctrl-A to pick every archived branch." <"$TMP/rows" >"$TMP/selected"; then
	:
else
	code=$?
	if [ "$code" -eq 1 ] || [ "$code" -eq 130 ]; then printf 'Cancelled.\n'; exit 0; fi
	exit "$code"
fi

: >"$TMP/eligible"
while IFS=$'\t' read -r id _; do
	jq -c --arg id "$id" 'select(.id == $id)' "$TMP/inventory" >>"$TMP/eligible"
done <"$TMP/selected"
if [ ! -s "$TMP/eligible" ]; then printf 'No branches selected.\n'; exit 0; fi

COUNT=$(wc -l <"$TMP/eligible" | tr -d ' ')
printf 'Selected %s branch(es):\n' "$COUNT"
jq -r '"  - " + (.name | @json) + " [" + .state + "]"' "$TMP/eligible"
if [ "$MODE" = dry-run ]; then printf 'Dry run: no branches deleted.\n'; exit 0; fi
printf 'Delete these %s branch(es)? [y/N] ' "$COUNT"
IFS= read -r reply || exit 0
case "$reply" in y|Y|yes|YES) ;; *) printf 'Cancelled.\n'; exit 0 ;; esac

deleted=0 failed=0
while IFS= read -r entry; do
	id=$(jq -r '.id' <<<"$entry")
	name=$(jq -r '.name | @json' <<<"$entry")
	if neon branches delete "$id" --project-id "$PROJECT_ID" >/dev/null 2>"$TMP/neon-error"; then
		printf 'Deleted %s\n' "$name"
		deleted=$((deleted + 1))
	else
		printf 'Failed to delete %s: %s\n' "$name" "$(tr '\n' ' ' <"$TMP/neon-error")" >&2
		failed=$((failed + 1))
	fi
done <"$TMP/eligible"
printf 'Done: %s deleted, %s failed.\n' "$deleted" "$failed"
[ "$failed" -eq 0 ]
