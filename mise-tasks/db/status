#!/usr/bin/env bash
#MISE description="Show current database branch info"
set -euo pipefail
# shellcheck source=mise-tasks/db/_neon.sh
source "${BASH_SOURCE[0]%/*}/_neon.sh"
require_neon_project

CURRENT_BRANCH=$(git branch --show-current)
echo "Git branch: $CURRENT_BRANCH"

if [ "$CURRENT_BRANCH" = "main" ]; then
	echo "Database: Vercel production (from vc env)"
	exit 0
fi

NEON_BRANCH=$(neon_branch_name "$CURRENT_BRANCH")
echo "Neon branch: $NEON_BRANCH"

if neon_branch_exists "$NEON_BRANCH"; then
	echo "Status: exists"
else
	echo "Status: not created yet"
fi
