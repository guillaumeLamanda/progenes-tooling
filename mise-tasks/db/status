#!/usr/bin/env bash
#MISE description="Show current database branch info"
set -euo pipefail

CURRENT_BRANCH=$(git branch --show-current)
echo "Git branch: $CURRENT_BRANCH"

if [ "$CURRENT_BRANCH" = "main" ]; then
	echo "Database: Vercel production (from vc env)"
	exit 0
fi

NEON_BRANCH="${DB_BRANCH_PREFIX-preview/}${CURRENT_BRANCH}"
NEON_BRANCH=$(LC_ALL=C; printf "%s" "${NEON_BRANCH//[^a-zA-Z0-9\/._-]/-}")
echo "Neon branch: $NEON_BRANCH"

if neon branches list --project-id "$NEON_PROJECT_ID" --output json |
	jq -e --arg name "$NEON_BRANCH" 'any(.[]; .name == $name)' >/dev/null; then
	echo "Status: exists"
else
	echo "Status: not created yet"
fi
