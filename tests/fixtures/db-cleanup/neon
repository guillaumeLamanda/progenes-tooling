#!/usr/bin/env bash
set -euo pipefail
case "$1 $2" in
	'branches list') cat "$MOCK_NEON_BRANCHES" ;;
	'branches delete')
		if [ "$3" = "${MOCK_NEON_FAIL:-}" ]; then printf 'boom\n' >&2; exit 1; fi
		printf '%s\n' "$3" >>"$MOCK_NEON_DELETED"
		;;
	*) printf 'unexpected neon call: %s\n' "$*" >&2; exit 2 ;;
esac
